# Copy to .env and fill in. .env is gitignored — never commit it.
# The recommender service reads these to re-login when the MDS token expires.

MDS_BASE_URL=https://fleet-green.moveinsync.com
MDS_USERNAME=medhaj.malhan@moveinsync.com
MDS_PASSWORD=

# Filled from the login response at runtime; leave blank.
# MDS auth uses three headers together: x-cds-token, user_detail, vendor_id
MDS_VENDOR_ID=

# Metabase, via the standalone Apps Script proxy (appscript/Code.gs)
APPS_SCRIPT_EXEC_URL=
APPS_SCRIPT_TOKEN=
METABASE_CARD_ID=130776
# `firstcut` is a SCHEMA inside the MISWarehouse database (id 3), not a database itself.
# Only needed for ad-hoc route=sql calls; route=card doesn't use it.
METABASE_DB_ID=3

# Rolling history window, in days. Measured: top-1 is flat past 30d.
HISTORY_WINDOW_DAYS=30

# Password for the recommender screen itself (HTTP Basic auth; any username).
# Empty = auth disabled (local development only). bootstrap.sh generates one
# automatically on servers if left blank.
UI_PASSWORD=
